{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "redirects": [
    {
      "source": "/peakactive",
      "destination": "https://turboducky.com/peakactive",
      "permanent": true
    },
    {
      "source": "/peakactive/:path*",
      "destination": "https://turboducky.com/peakactive/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
