{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/peakactive/:path*",
      "destination": "/peakactive.html"
    },
    {
      "source": "/peakactive",
      "destination": "/peakactive.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}